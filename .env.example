# Copy this file to ".env" for your own computer (the real .env is never committed),
# or enter these as "environment variables" in your hosting dashboard.

# development (default) or production
APP_ENV=development

# REQUIRED in production: a long random value. Create one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Optional: where the data lives. Leave it out to use a local SQLite file.
#   SQLite file : sqlite:////absolute/path/to/minibazar.db
#   PostgreSQL  : postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# Optional: number of proxies in front of the app (1 on most hosts; 0 on your own computer).
# TRUSTED_PROXIES=1

# Optional: folder for uploaded product photos (use a persistent disk on a live site).
# UPLOAD_FOLDER=/var/data/uploads

# Optional: minutes to add to UTC when showing times (330 = India).
# DISPLAY_TZ_OFFSET_MINUTES=330
